{
  "name": "@eazo/genauth-agent-cli",
  "version": "0.1.1",
  "description": "GenAuth Agent Identity CLI",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "genauth-agent": "dist/bin/genauth-agent.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EazoAI/Genauth-Agent-CLI.git"
  },
  "homepage": "https://github.com/EazoAI/Genauth-Agent-CLI#readme",
  "bugs": {
    "url": "https://github.com/EazoAI/Genauth-Agent-CLI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/finalize-build.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run contract:export && vitest run --config vitest.e2e.config.ts",
    "metadata:check": "node scripts/verify-release-metadata.mjs",
    "verify": "npm run check && npm run test:coverage && npm run build && npm run contract:export && npm run metadata:check && npm run pack:check",
    "dev": "tsx src/bin/genauth-agent.ts",
    "contract:export": "tsx scripts/export-command-contract.ts",
    "skills:verify": "tsx scripts/verify-skills.ts ../genauth-agent-skill",
    "pack:check": "tsx scripts/pack-smoke.ts",
    "smoke:npm": "node scripts/smoke-npm-install.mjs"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^15.0.0",
    "undici": "^8.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
